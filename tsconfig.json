{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["*.ts", "app/**/*.ts", "commands/**/*.ts", "digest/**/*.ts", "moderation/**/*.ts", "shared/**/*.ts", "storage/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "dist", "calendar-studio"]
}
